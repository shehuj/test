# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real values.

aws_region      = "us-east-1"
environment     = "prod"
cluster_name    = "eks-prod"
cluster_version = "1.31"
owner           = "platform-team"

vpc_cidr             = "10.0.0.0/16"
private_subnet_cidrs = ["10.0.0.0/19", "10.0.32.0/19", "10.0.64.0/19"]
public_subnet_cidrs  = ["10.0.128.0/20", "10.0.144.0/20", "10.0.160.0/20"]

# Keep public endpoint disabled; access via VPN or bastion host.
endpoint_private_access = true
endpoint_public_access  = false
public_access_cidrs     = []

system_node_instance_types = ["m5.large"]
system_node_min            = 2
system_node_max            = 6
system_node_desired        = 2

app_node_instance_types = ["m5.2xlarge"]
app_node_min            = 2
app_node_max            = 20
app_node_desired        = 3

node_volume_size = 50

cluster_log_retention_days = 365  # minimum 365 — enforced by variable validation
flow_log_retention_days    = 365  # minimum 365 — enforced by variable validation

# Leave empty to disable SSH access to nodes entirely (recommended).
allowed_ssh_cidrs = []
